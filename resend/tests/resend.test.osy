using Osysharp.Http;
using Osysharp.Identity;
using Osysharp.Mail;

[TestFixture]
void Desk() {
  var ada = new Person { Email = "ada@acme.test" };
  new RoleGrant { Member = ada, Role = AppRole.Agent };
  Http.Post.Stub((url, body) => {
    new WireLog { Url = url, Body = body };
    return new HttpResponse { StatusCode = 200, Body = "{\"id\":\"re-123\"}" };
  });
}

principal Ada => Person.Single(p => p.Email == "ada@acme.test");

[Test(Desk)]
void a_message_reaches_resend_with_its_own_message_id_and_answers_resends_id() {
  runas (Ada) {
    var mail = Notify("cus@example.test", "Your ticket");
    UnitOfWork.Commit();
    Workflow.Settle(mail);
  }
  runas (Ada) {
    var sent = OutgoingMail.Single(m => m.Subject == "Your ticket");
    Assert.Equal(MailStatus.Sent, sent.Status);
    Assert.Equal("re-123", sent.ProviderId);
    var wire = WireLog.Single(w => w.Body.Contains("Your ticket"));
    Assert.Equal("https://api.resend.com/emails", wire.Url);
    Assert.Contains("\"to\":[\"cus@example.test\"]", wire.Body);
    // The JSON escapes the angle brackets (`\u003C…\u003E`), so the id is matched between them.
    Assert.Contains("\"Message-ID\":\"\\u003C" + Bare(sent.MessageId) + "\\u003E\"", wire.Body);
  }
}

[Test(Desk)]
void a_reply_carries_its_threading_headers_to_resend() {
  runas (Ada) {
    var first = Notify("cus@example.test", "Your ticket");
    UnitOfWork.Commit();
    var reply = Answer(first);
    UnitOfWork.Commit();
    Workflow.Settle(reply);
  }
  runas (Ada) {
    var first = OutgoingMail.Single(m => m.Subject == "Your ticket");
    var wire = WireLog.Single(w => w.Body.Contains("Re: Your ticket"));
    Assert.Contains("\"In-Reply-To\":\"\\u003C" + Bare(first.MessageId) + "\\u003E\"", wire.Body);
    Assert.Contains("\"References\":\"\\u003C" + Bare(first.MessageId) + "\\u003E\"", wire.Body);
  }
}

// ── WHAT BECAME OF IT: Resend's report that a mail bounced is kept on the message, so the app can say so instead of
//    leaving somebody to wait for a code that will never come. Only a report signed with the app's webhook secret is
//    believed — anyone can reach the endpoint.
[Test(Desk)]
void a_bounce_resend_reports_is_kept_on_the_message_and_a_forged_one_is_not() {
  runas (Ada) {
    var mail = Notify("gone@example.test", "Your code");
    UnitOfWork.Commit();
    Workflow.Settle(mail);
  }
  // A report signed with another key is refused, and keeps nothing.
  var forged = SignedReport("not-the-apps-key", "email.bounced", "re-123", "gone@example.test");
  Assert.Throws<ValidationException>(() => TakeResendReport(forged[0], forged[1], forged[2], forged[3]));
  UnitOfWork.Commit();
  Background.Settle();
  runas (Ada) { Assert.Null(OutgoingMail.Single(m => m.Subject == "Your code").Delivery); }

  // Resend's own report: kept, in Resend's words, and the outbox answers that mail to the address did not arrive.
  var bounced = SignedReport("the-webhook-signing-key-for-tests", "email.bounced", "re-123", "gone@example.test");
  TakeResendReport(bounced[0], bounced[1], bounced[2], bounced[3]);
  UnitOfWork.Commit();
  Background.Settle();
  // A "delivered" arriving after it does not hide the bounce.
  var delivered = SignedReport("the-webhook-signing-key-for-tests", "email.delivered", "re-123", "gone@example.test");
  TakeResendReport(delivered[0], delivered[1], delivered[2], delivered[3]);
  UnitOfWork.Commit();
  Background.Settle();
  runas (Ada) {
    var sent = OutgoingMail.Single(m => m.Subject == "Your code");
    Assert.Equal(MailDelivery.Bounced, sent.Delivery);
    Assert.NotNull(sent.DeliveryReportedAt);
    var undelivered = UndeliveredTo("gone@example.test", DateTime.UtcNow - TimeSpan.FromHours(1));
    Assert.NotNull(undelivered);
    Assert.Equal("Mail to gone@example.test bounced (Permanent General: mailbox does not exist).", UndeliveredSentence(undelivered!));
    Assert.Null(UndeliveredTo("someone-else@example.test", DateTime.UtcNow - TimeSpan.FromHours(1)));
  }
}

/// `<abc@acme.test>` → `abc@acme.test`.
string Bare(string messageId) { return messageId.Replace("<", "").Replace(">", ""); }
