// The producer's test project for Osysharp.Mail.Imap — a watched IMAP mailbox and replies over SMTP, asserted on what
// the stubbed servers were asked and what the app kept. `Imap.Fetch` and `Smtp.Send` are stubbed, so nothing leaves the
// process; the platform's own IMAP/SMTP is tested against protocol-level fakes (MailKitMailTransportTests).
app MailImapKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Mail.Receiving@0;
  use Osysharp.Mail.Imap@0 { egress "imap.acme.test"; egress "smtp.acme.test"; }
  use Osysharp.Workflow;
  use Osysharp.Storage;
  use Osysharp.Http;
}

