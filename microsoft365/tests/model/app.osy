using Osysharp.Identity;
using Osysharp.Mail;
using Osysharp.Mail.Receiving;
using Osysharp.Mail.Microsoft365;

[Role] enum AppRole { Authenticator, Agent }

policy IsAgent => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Agent);
// Who manages the mailboxes (Osysharp.Mail.Receiving's page) — this app has no admins, so its agent staff.
policy ManagesMailboxes => IsAgent;

entity Person : Principal {
  security {
    allow read when IsAuthenticated || IsAuthenticator;
    allow create when IsAuthenticator;
    allow update when IsAuthenticated || IsAuthenticator where Id == user.Id;
    allow update when IsAuthenticator;
  }
}

partial entity OutgoingMail { security { allow create, read when IsAgent; } }
partial entity OutgoingMailFile { security { allow create, read when IsAgent; } }
partial entity MailboxWatch { security { allow create, read when IsAgent; } }
partial entity ReceivedMail { security { allow read when IsAgent; } }

/// In a real app the secret is `Secret.X`; a literal here, because every test stubs Graph.
app.Mail = new MailSetup {
  Mailboxes = [
    // Polled, so the delta tests below ask on their own clock.
    new Microsoft365Mailbox { Address = "support@acme.test", TenantId = "tenant-1", ClientId = "client-1",
                              ClientSecret = "client-secret", Push = false },
    // Pushed: subscribed to Graph change notifications through the app's push door.
    new Microsoft365Mailbox { Address = "push@acme.test", TenantId = "tenant-1", ClientId = "client-1",
                              ClientSecret = "client-secret" },
  ],
  Receiver = new Recorder(),
  PushPath = "/api/rest/v1/mail-push",
};

// The app's push door, where `PushPath` says.
app.Apis = [
  new RestApi("MailPush") {
    Route = "mail-push",
    Auth  = new ApiAuth { Anonymous = true },
    Endpoints = [
      new Endpoint(MailboxPushed) {
        Method = HttpMethod.Post, Path = "/{provider}", Raw = true,
        Query = ["validationToken"], ContentType = "text/plain", OidcIssuer = "https://accounts.google.com",
      },
    ],
  },
];

/// What the stubs say Graph is doing right now.
entity Graph {
  /// Which delta round the stubs are on: every round's link carries its number.
  int Round = 0;
  /// The delta link answers 410 — Graph let the sync state lapse.
  bool Lapsed = false;
  /// Graph no longer knows the subscription (a PATCH answers 404).
  bool LostSubscription = false;
  /// How many subscriptions the stub has made.
  int Subscriptions = 0;
  security { allow read, create, update when IsAuthenticated || IsAuthenticator || IsAnonymous; }
}

/// A message that arrived in the stubbed inbox in a given round.
entity GraphMessage {
  [Required, MaxLength(60)] string GraphId;
  int Round;
  bool Removed = false;
  [Required] string Raw;
  security { allow read, create when IsAuthenticated || IsAuthenticator || IsAnonymous; }
}

entity WireLog {
  [Required, MaxLength(10)] string Verb;
  [Required, MaxLength(800)] string Url;
  string Body = "";
  [MaxLength(100)] string ContentType = "";
  security { allow read, create when IsAuthenticated || IsAuthenticator || IsAnonymous; }
}

entity Handled {
  [Required, MaxLength(300)] string Subject;
  [MaxLength(300)] string MessageId = "";
  security { allow read when IsAuthenticated; }
}

public class Recorder : IMailReceiver {
  public void Received(MailMessage mail, MailReceipt receipt) {
    new Handled { Subject = mail.Subject, MessageId = mail.MessageId };
  }
}

/// The delta link of a round — what the next poll asks.
string DeltaLink(int round) {
  return "https://graph.microsoft.com/v1.0/users/support%40acme.test/mailFolders/inbox/messages/delta?$deltatoken=r" + round.ToString();
}

/// The changes a delta link answers: every message that arrived in its round, and the next round's link.
string DeltaJson(int round) {
  var parts = GraphMessage.Where(m => m.Round == round).ToList().Select(m => m.Removed
    ? "{\"id\":\"" + m.GraphId + "\",\"@removed\":{\"reason\":\"deleted\"}}"
    : "{\"id\":\"" + m.GraphId + "\"}").ToList();
  return "{\"value\":[" + string.Join(",", parts) + "],\"@odata.deltaLink\":\"" + DeltaLink(round + 1) + "\"}";
}

void Arrive(string graphId, string raw, bool removed = false) {
  new GraphMessage { GraphId = graphId, Round = Graph.Single().Round, Raw = raw, Removed = removed };
}
