// The producer's test project for Osysharp.Mail.Microsoft365 — a watched mailbox and replies sent from it, asserted on
// what reached Microsoft Graph and what the app kept. Every test stubs `Http.*` as Graph's documented endpoints answer.
app MailMicrosoft365KitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Mail.Receiving@0;
  use Osysharp.Mail.Microsoft365@0 { egress "login.microsoftonline.com"; egress "graph.microsoft.com"; }
  use Osysharp.Workflow;
  use Osysharp.Storage;
  use Osysharp.Http;
}

