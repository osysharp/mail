// Osysharp.Mail.Gmail — every test stubs Google exactly as its documented endpoints answer (token, profile, history,
// messages/{id}?format=raw, messages/send), and asserts what the app KEPT or what reached the wire.

using Osysharp.Http;
using Osysharp.Identity;
using Osysharp.Mail;
using Osysharp.Mail.Receiving;
using Osysharp.Mail.Gmail;

[TestFixture]
void Inbox() {
  var ada = new Person { Email = "ada@acme.test", DisplayName = "Ada" };
  new RoleGrant { Member = ada, Role = AppRole.Agent };
  new Google();
  Http.Post.Stub((url, body) => {
    new WireLog { Verb = "POST", Url = url, Body = body };
    if (url == "https://oauth2.googleapis.com/token") {
      return Google.Single().Refuses
        ? new HttpResponse { StatusCode = 400, Body = "{\"error\":\"invalid_grant\"}" }
        : new HttpResponse { StatusCode = 200, Body = "{\"access_token\":\"ya29.token\",\"expires_in\":3599}" };
    }
    if (url.EndsWith("/watch")) {
      return new HttpResponse { StatusCode = 200, Body = "{\"historyId\":\"" + Google.Single().HistoryId.ToString() + "\",\"expiration\":\"4102444800000\"}" };
    }
    if (url.EndsWith("/stop")) { return new HttpResponse { StatusCode = 204, Body = "" }; }
    return new HttpResponse { StatusCode = 200, Body = "{\"id\":\"sent-1\",\"threadId\":\"t-1\"}" };
  });
  Http.Get.Stub(url => {
    new WireLog { Verb = "GET", Url = url };
    var api = "https://gmail.googleapis.com/gmail/v1/users/me";
    if (url == api + "/profile") {
      return new HttpResponse { StatusCode = 200,
        Body = "{\"emailAddress\":\"support@acme.test\",\"historyId\":\"" + Google.Single().HistoryId.ToString() + "\"}" };
    }
    if (url.StartsWith(api + "/history?")) {
      if (Google.Single().HistoryGone) { return new HttpResponse { StatusCode = 404, Body = "{}" }; }
      var start = url.Substring(url.IndexOf("startHistoryId=") + 15);
      return new HttpResponse { StatusCode = 200, Body = HistoryJson(start) };
    }
    var id = url.Substring(url.IndexOf("/messages/") + 10).Replace("?format=raw", "");
    return new HttpResponse { StatusCode = 200, Body = RawJson(GmailMessage.Single(m => m.GmailId == id)) };
  });
}

principal Ada => Person.Single(p => p.Email == "ada@acme.test");

string Mail(string id, string subject) {
  return "From: Cus <cus@example.test>\nTo: support@acme.test\nSubject: " + subject + "\nMessage-ID: " + id
    + "\nMIME-Version: 1.0\nContent-Type: text/plain\n\nHello.\n";
}

void Watch() {
  var w = WatchMailbox("support@acme.test");
  UnitOfWork.Commit();
  Workflow.Settle(w);
}

void Poll() {
  Workflow.Settle(MailboxWatch.Single());
  foreach (var r in ReceivedMail.ToList()) { Workflow.Settle(r); }
}

[Test(Inbox)]
void a_new_watch_starts_at_the_inboxs_history_id_and_imports_nothing_older() {
  runas (Ada) {
    Arrive("m-old", 999, Mail("<old@example.test>", "Before"));
    Watch();
  }
  runas (Ada) {
    Assert.Equal("999", MailboxWatch.Single().Cursor);
    Assert.False(ReceivedMail.Any());
    // The refresh token went to Google's token endpoint in the form body, nowhere else.
    var token = WireLog.First(w => w.Url == "https://oauth2.googleapis.com/token");
    Assert.Contains("grant_type=refresh_token", token.Body);
    Assert.Contains("refresh_token=refresh-1", token.Body);
  }
}

[Test(Inbox)]
void mail_added_to_the_inbox_is_fetched_whole_and_kept_and_sent_mail_is_not() {
  runas (Ada) { Watch(); }
  runas (Ada) {
    Arrive("m-1", 1001, Mail("<one@example.test>", "Broken export"));
    Arrive("m-2", 1002, Mail("<ours@acme.test>", "Re: Broken export"), "SENT");
    UnitOfWork.Commit();
    TestClock.Advance(TimeSpan.FromMinutes(1));
    Poll();
  }
  runas (Ada) {
    var kept = ReceivedMail.Single();
    Assert.Equal("m-1", kept.ProviderId);
    Assert.Equal("<one@example.test>", kept.MessageId);
    Assert.Equal("Broken export", kept.Subject);
    Assert.Equal(1, Handled.Count(h => h.MessageId == "<one@example.test>"));
    Assert.Equal("1002", MailboxWatch.Single().Cursor);
    Assert.True(WireLog.Any(w => w.Url == "https://gmail.googleapis.com/gmail/v1/users/me/messages/m-1?format=raw"));
    Assert.False(WireLog.Any(w => w.Url.Contains("/messages/m-2")));
  }
}

[Test(Inbox)]
void a_reply_goes_through_the_send_api_as_the_message_the_outbox_built() {
  runas (Ada) {
    var reply = SendMail(new MailMessage {
      From = "Acme Support <support@acme.test>", To = ["cus@example.test"], Subject = "Re: Broken export",
      Text = "Fixed.", InReplyTo = "<one@example.test>", References = ["<one@example.test>"],
    });
    UnitOfWork.Commit();
    Workflow.Settle(reply);
  }
  runas (Ada) {
    var sent = OutgoingMail.Single();
    Assert.Equal(MailStatus.Sent, sent.Status);
    Assert.Equal("gmail", sent.SentWith);
    Assert.Equal("sent-1", sent.ProviderId);
    var wire = WireLog.Single(w => w.Url == "https://gmail.googleapis.com/gmail/v1/users/me/messages/send");
    var raw = JsonSerializer.Deserialize<GmailRaw>(wire.Body).Raw;
    var mail = ParseMail(FromBase64Url(raw));
    Assert.Equal("<one@example.test>", mail.InReplyTo);
    Assert.Equal(sent.MessageId, mail.MessageId);
    Assert.Equal("Acme Support <support@acme.test>", mail.From);
  }
}

[Test(Inbox)]
void refused_credentials_are_said_on_the_watch_with_what_to_do() {
  runas (Ada) { Watch(); }
  runas (Ada) {
    Google.Single().Refuses = true;
    UnitOfWork.Commit();
    TestClock.Advance(TimeSpan.FromMinutes(1));
    Poll();
  }
  runas (Ada) {
    Assert.Contains("Grant the mailbox again", MailboxWatch.Single().Problem);
    Assert.Equal("1000", MailboxWatch.Single().Cursor);
  }
}

[Test(Inbox)]
void history_google_no_longer_keeps_restarts_from_now_and_says_so() {
  runas (Ada) { Watch(); }
  runas (Ada) {
    Google.Single().HistoryGone = true;
    Google.Single().HistoryId = 5000;
    UnitOfWork.Commit();
    TestClock.Advance(TimeSpan.FromMinutes(1));
    Poll();
  }
  runas (Ada) {
    Assert.Equal("5000", MailboxWatch.Single().Cursor);
    Assert.Contains("was not taken in", MailboxWatch.Single().Problem);
  }
}

[Test(Inbox)]
void a_mailbox_with_no_refresh_token_is_not_ready_and_says_which_setting() {
  var box = new GmailMailbox { Address = "help@acme.test", ClientId = "c", ClientSecret = "s" };
  Assert.False(box.IsReady());
  Assert.Contains("no refresh token yet", box.NotReadyReason());
}

// ── push (0.2.0): users.watch → Cloud Pub/Sub → the app's push door ─────────────────────────────────────────────

/// What Pub/Sub POSTs: the change Gmail published, base64 in `message.data`.
string PubSub(string address, int historyId) {
  var data = Convert.ToBase64String(Encoding.UTF8.GetBytes(
    "{\"emailAddress\":\"" + address + "\",\"historyId\":" + historyId.ToString() + "}"));
  return "{\"message\":{\"data\":\"" + data + "\",\"messageId\":\"m-" + historyId.ToString()
    + "\"},\"subscription\":\"projects/acme/subscriptions/mail-push\"}";
}

MailboxWatch PushBox() { return MailboxWatch.Single(w => w.Address == "push@acme.test"); }

void WatchPushBox() {
  var w = WatchMailbox("push@acme.test");
  UnitOfWork.Commit();
  Workflow.Settle(w);
}

[Test(Inbox)]
void a_mailbox_with_a_push_topic_is_watched_through_pub_sub_until_gmail_says() {
  runas (Ada) { WatchPushBox(); }
  runas (Ada) {
    var watch = WireLog.Single(w => w.Url == "https://gmail.googleapis.com/gmail/v1/users/me/watch");
    Assert.Contains("\"topicName\":\"projects/acme/topics/mail\"", watch.Body);
    Assert.Contains("INBOX", watch.Body);
    Assert.Equal(2100, PushBox().PushExpiresAt!.Value.Year);
    Assert.Equal("", PushBox().PushProblem);
  }
}

[Test(Inbox)]
void a_push_signed_by_the_subscriptions_service_account_wakes_a_fetch_of_the_history() {
  PushSenderOf.Stub(audience => "mail-push@acme.iam.gserviceaccount.com");
  runas (Ada) { WatchPushBox(); }
  runas (Ada) {
    Arrive("m-9", 1001, Mail("<pushed@example.test>", "Pushed in"));
    UnitOfWork.Commit();
    Assert.Equal(200, Api.Post("/api/rest/v1/mail-push/gmail", PubSub("push@acme.test", 1001)).StatusCode);
    Assert.Equal(MailboxWatchState.Woken, PushBox().State);
    TestClock.Advance(TimeSpan.FromSeconds(5));
    Workflow.Settle(PushBox());
    foreach (var r in ReceivedMail.ToList()) { Workflow.Settle(r); }
  }
  runas (Ada) {
    Assert.Equal("<pushed@example.test>", ReceivedMail.Single(r => r.Mailbox == "push@acme.test").MessageId);
    Assert.Equal(1, Handled.Count(h => h.MessageId == "<pushed@example.test>"));
  }
}

[Test(Inbox)]
void a_push_signed_by_anyone_else_is_refused_and_wakes_nothing() {
  PushSenderOf.Stub(audience => "someone@elsewhere.iam.gserviceaccount.com");
  runas (Ada) { WatchPushBox(); }
  runas (Ada) {
    Assert.Equal(400, Api.Post("/api/rest/v1/mail-push/gmail", PubSub("push@acme.test", 1001)).StatusCode);
    Assert.Equal(MailboxWatchState.Watching, PushBox().State);
    Assert.Equal(0, PushBox().Pushes);
  }
}

[Test(Inbox)]
void a_push_unsigned_by_any_verified_token_is_refused() {
  // No stub: the request carries no bearer token, so the platform verified nothing and the sender is nobody.
  runas (Ada) { WatchPushBox(); }
  runas (Ada) {
    Assert.Equal(400, Api.Post("/api/rest/v1/mail-push/gmail", PubSub("push@acme.test", 1001)).StatusCode);
    Assert.Equal(0, PushBox().Pushes);
  }
}

[Test(Inbox)]
void a_push_for_an_inbox_this_app_does_not_watch_wakes_nothing() {
  PushSenderOf.Stub(audience => "mail-push@acme.iam.gserviceaccount.com");
  runas (Ada) { WatchPushBox(); }
  runas (Ada) {
    Assert.Equal(200, Api.Post("/api/rest/v1/mail-push/gmail", PubSub("stranger@acme.test", 1001)).StatusCode);
    Assert.Equal(MailboxWatchState.Watching, PushBox().State);
  }
}

[Test(Inbox)]
void a_watch_that_stops_tells_gmail_to_stop_pushing() {
  runas (Ada) { WatchPushBox(); }
  runas (Ada) { StopWatchingMailbox(PushBox()); UnitOfWork.Commit(); }
  runas (Ada) { Assert.True(WireLog.Any(w => w.Url == "https://gmail.googleapis.com/gmail/v1/users/me/stop")); }
}
